# Ingestion only. The app itself never calls the Claude API — only the scripts
# under ingest/ do, and they read this from the environment.
#
# You do not need a key here if you have run `ant auth login`: the SDK finds
# that profile on its own.
ANTHROPIC_API_KEY=

# Override where the SQLite file lives (default: data/quant.db)
# QUANT_DB=/absolute/path/quant.db

# 助教（作答畫面裡的 LLM 討論與推導批改）。沒設的話助教會回 503。
#
# 預設走 Gemini。討論用 thinking_level=low（助教想十秒才問一句話就不是對話了），
# 批改用 high（批改錯得有自信的代價最高）。
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# 想換回 Claude：LLM_PROVIDER=claude，並設 ANTHROPIC_API_KEY。
# LLM_PROVIDER=gemini
# CLAUDE_MODEL=claude-opus-5

# 沒有憑證時跑罐頭助教，用來驗 UI：TUTOR_MOCK=1 npm run dev
# TUTOR_MOCK=1
